USUARIO=$(whoami)
FECHA=$(date +"%d-%m-%Y:%H:%M")
DESTINO="/home/$USUARIO/backup-$FECHA.tar.gz"

tar -czvf "$DESTINO" "/home/$USUARIO"

echo "Backup creado correctamente: $DESTINO"
chmod +x backup.sh
./backup.sh
